{% extends "src/_layouts/tool.njk" %}


{% block tool_head %}
<script src="https://cdn.jsdelivr.net/npm/p5@1.11.10/lib/p5.min.js" defer async></script>
{% endblock %}


{% block tool %}

<header>
    <h1>Tool UI Test</h1>
    <p class="muted">
        This page exists to preview the default tool styles.
    </p>
</header>

<hr>

<section class="col">

    <div>
        <label for="text">Text</label>
        <input
            id="text"
            type="text"
            placeholder="Hello, world!"
        >
    </div>

    <div>
        <label for="number">Number</label>
        <input
            id="number"
            type="number"
            placeholder="42"
        >
    </div>

    <div>
        <label for="select">Select</label>
        <select id="select">
            <option>Option 1</option>
            <option>Option 2</option>
            <option>Option 3</option>
        </select>
    </div>

    <div>
        <label for="textarea">Textarea</label>
        <textarea
            id="textarea"
            placeholder="Write something..."
        ></textarea>
    </div>

    <div>
      <p><b>Canvas</b></p>
      <div id="canvas"></div>
    </div>

</section>

<hr>

<section>

    <h2>Row Layout</h2>

    <div class="row">
        <input
            class="grow"
            type="text"
            placeholder="Search..."
        >
        <button>Go</button>
    </div>

</section>

<section>

    <h2>Buttons</h2>

    <div class="inline">
        <button id="generate-btn">Generate</button>
        <button>Copy</button>
        <button disabled>Disabled</button>
    </div>

</section>

<section>

    <h2>Output</h2>

    <div class="output">
        <p><strong>Status:</strong> Success</p>
        <p class="muted">Generated in 2 ms.</p>
    </div>

</section>

<section>

    <h2>Table</h2>

    <table>
        <thead>
            <tr>
                <th>Property</th>
                <th>Value</th>
            </tr>
        </thead>

        <tbody>
            <tr>
                <td>Characters</td>
                <td>183</td>
            </tr>

            <tr>
                <td>Words</td>
                <td>29</td>
            </tr>

            <tr>
                <td>Lines</td>
                <td>8</td>
            </tr>
        </tbody>
    </table>

</section>

<section>

    <h2>Code</h2>

    <pre><code>function hello() {
console.log("Hello, world!");
}</code></pre>

</section>

<section>

    <h2>Utilities</h2>

    <div class="row">
        <span class="mono">SHA256</span>
        <span class="grow"></span>
        <button>Copy</button>
    </div>

    <p class="muted">
        Utility text for hints or additional information.
    </p>

</section>

<section>

    <h2>Lists</h2>

    <ul>
        <li>Fast</li>
        <li>Minimal</li>
        <li>Self-contained</li>
    </ul>

</section>

{% endblock %}
